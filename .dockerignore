# Version control
.git
.gitattributes
.gitignore

# Secrets — never in image
.env
.env.*
!.env.example
# Exception: frontend/.env.demo only sets VITE_DEMO=1 (no secret) and is REQUIRED
# by Dockerfile.demo — `vite build --mode demo` reads it. Without this rule the
# demo image would silently ship the production SPA, i.e. no mock API at all.
!frontend/.env.demo

# Python artifacts
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# Frontend: node_modules and compiled output (rebuilt inside the image)
frontend/node_modules/
frontend/dist/
frontend/dist-demo/
frontend/.vite/

# Tests (not needed at runtime)
tests/

# Project management / squad docs
.squad/
DEPLOY.md

# Editor & OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
