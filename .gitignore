# Environment secrets
.env

# Runtime data: the local stack writes uploaded bank statements here, and a
# backup export dropped in the working tree would be committable by accident.
# Neither belongs in git — this is real financial data.
data/
*.backup.json
finlytics-backup*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.pytest_cache/

# Node / frontend
node_modules/
frontend/dist/
# Static demo build output (npm run build:demo)
frontend/dist-demo/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# ── Squad (AI agent team) ─────────────────────────────────────────────────────
# Policy taken from what `squad init` writes into a consumer repo
# (squad-sdk/src/config/init.ts), NOT from the Squad repo's own .gitignore —
# that one also hides `config.json` and `_upstream_repos/` because they run
# `squad externalize` on their dev machines. Here the state backend is `local`,
# so the team's memory is committed and travels with the repo.
#
# Only per-machine RUNTIME STATE is ignored:
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
#
# Deliberately NOT ignored:
#   .squad/config.json   — project config (mcpConfigMode), written by `squad init`
#   .squad/casting/*     — AUTHORITATIVE IDENTITY; must live on main
#   .squad/decisions.md  — only gitignored under the two-layer/orphan state
#                          backend, where the squad-state branch owns it
#
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Golden-set fixtures: owner's private real PDFs (never commit real statements)
tests/fixtures/statements/local/

# Local host data dir (bind-mounted to /app/data) — uploaded statement PDFs, never commit
/data/

# Squad tooling kept out of main (lives on the local dev branch + master backup).
# Note: .squad/ itself is NOT listed here — see the Squad block above.
.copilot/
.squad-workstream
.github/agents/squad.agent.md
.github/workflows/squad-heartbeat.yml
.github/workflows/squad-issue-assign.yml
.github/workflows/squad-triage.yml
.github/workflows/sync-squad-labels.yml
