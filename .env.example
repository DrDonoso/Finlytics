# ==============================================================================
# Finlytics — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the required values.
# Lines starting with # are comments; uncomment to override defaults.

# --- PostgreSQL (REQUIRED) ---------------------------------------------------
POSTGRES_PASSWORD=changeme-use-a-strong-password

# Optional — override database name and user (defaults: finlytics / finlytics)
# POSTGRES_USER=finlytics
# POSTGRES_DB=finlytics

# --- OpenAI-compatible AI (self-hosted LiteLLM) for transaction extraction ----
# Set ALL THREE to enable AI-powered extraction; leave unset to disable.
# Standard OpenAI-compatible variables (work with a self-hosted LiteLLM proxy).
# OPENAI_API_KEY=your-litellm-key
# OPENAI_BASE_URL=https://your-litellm-host/v1
# OPENAI_MODEL=your-model-name

# --- App config ---------------------------------------------------------------
# FINLYTICS_PORT=8000            # Host port for the API (default: 8000)
# TIMEZONE=Europe/Madrid         # Timezone for date display (default: Europe/Madrid)

# --- Auth -----------------------------------------------------------------
# Secret key for signing session tokens. If unset, a random key is generated
# on each startup (sessions won't survive container restarts).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_SECRET=your-random-secret-here
# If DATABASE_URL is not set (e.g. outside docker-compose), the app builds it
# from these individual components (host defaults to "db" for docker-compose).
# POSTGRES_HOST=localhost         # Override when running the API outside Docker
# POSTGRES_PORT=5432
