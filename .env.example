# ==============================================================================
# Finlytics — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the required values.
# Lines starting with # are comments; uncomment to override defaults.

# --- PostgreSQL (REQUIRED) ---------------------------------------------------
# Replace with your own value — do not ship the placeholder below.
POSTGRES_PASSWORD=changeme-use-a-strong-password

# Optional — override database name and user (defaults: finlytics / finlytics)
# POSTGRES_USER=finlytics
# POSTGRES_DB=finlytics

# --- OpenAI (for AI transaction extraction) ----------------------------------
# Set ALL THREE to enable AI-powered extraction; leave unset to disable.
# Standard OpenAI environment variables.
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- App config ---------------------------------------------------------------
# FINLYTICS_PORT=7777            # Host port for the API (default: 7777)
# TIMEZONE=Europe/Madrid         # Application timezone (default: Europe/Madrid).
                                 # Decides which calendar day the statement and
                                 # ESPP reminders use. The container runs in UTC,
                                 # so without this a reminder would be evaluated
                                 # against the wrong day during the hours when UTC
                                 # and local time disagree. docker-compose also
                                 # propagates it as TZ.

# Host directory mounted into the container at /app/data.
# Original statement PDFs are stored under <FINLYTICS_DATA_DIR>/uploads/.
# Defaults to ./data (relative to where you run docker compose).
# On Linux: the directory must be writable by uid 1000 (the container's "app" user).
#   e.g.  chown -R 1000:1000 ./data
FINLYTICS_DATA_DIR=./data

# --- Auth -----------------------------------------------------------------
# Secret key for signing session tokens. REQUIRED for sessions to survive
# container restarts/deploys. If unset, a random ephemeral key is generated
# on each startup and all sessions are invalidated on every restart.
#
# NEVER ship a value copied from this file — it is public. The app refuses to
# start if AUTH_SECRET is left at a placeholder, because anyone could then
# forge a session cookie and take over the instance.
#
# Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_SECRET=

# Token lifetime in days (default: 7)
# AUTH_TOKEN_EXPIRE_DAYS=7

# Set to true when the app is behind an HTTPS reverse proxy (default: false for localhost)
# AUTH_COOKIE_SECURE=false

# Failed logins are throttled per client IP (never per username: keying on the
# username would let anyone lock out the legitimate account by guessing against
# it). Set AUTH_LOGIN_MAX_ATTEMPTS=0 to disable the limit entirely.
# Behind a reverse proxy, run uvicorn with --proxy-headers so the real client IP
# reaches the app; otherwise every request looks like it comes from the proxy.
# AUTH_LOGIN_MAX_ATTEMPTS=10
# AUTH_LOGIN_WINDOW_SECONDS=300
# If DATABASE_URL is not set (e.g. outside docker-compose), the app builds it
# from these individual components (host defaults to "db" for docker-compose).
# POSTGRES_HOST=localhost         # Override when running the API outside Docker
# POSTGRES_PORT=5432

# --- Investments — connector token encryption --------------------------------
# App-wide Fernet key for encrypting all connector API tokens at rest.
# The app starts normally without this key; only encrypt/decrypt operations
# (connecting or fetching a portfolio) fail with HTTP 503 when it is absent.
# Required to use the Indexa Capital connector (and any future connector).
#
# Generate once, store in .env, NEVER commit the actual key to version control:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FINLYTICS_ENCRYPTION_KEY=
