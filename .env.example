# ==============================================================================
# Finlytics — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the two values at the top. Everything else
# has a working default — uncomment only what you actually want to change.

# --- Required -----------------------------------------------------------------
# PostgreSQL password. Replace the placeholder below with your own.
POSTGRES_PASSWORD=changeme-use-a-strong-password

# Signs session cookies. Leave it unset and a new key is generated on every
# startup, which logs you out on every restart. Never copy a value from this
# file — it is public, and anyone could forge a session with it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=

# --- AI extraction and the finance assistant (optional) -----------------------
# Set ALL THREE to enable statement extraction and the "talk to your finances"
# chat. They share one key: with these unset, extraction is disabled and the
# assistant hides its launcher rather than offering a button that can only fail.
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Investment connectors (optional) -----------------------------------------
# Fernet key that encrypts connector API tokens and the Telegram bot token at
# rest. The app starts without it; only connecting a provider fails (HTTP 503).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FINLYTICS_ENCRYPTION_KEY=

# --- Everything else ----------------------------------------------------------
# TIMEZONE=Europe/Madrid    # Calendar day the statement/ESPP reminders use.
                            # The container runs in UTC, so this is what keeps a
                            # reminder from firing against the wrong day.
# AUTH_COOKIE_SECURE=true   # Set when serving over HTTPS, so the session cookie
                            # gets the Secure flag.
# POSTGRES_USER=finlytics
# POSTGRES_DB=finlytics
