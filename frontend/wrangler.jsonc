// Cloudflare Workers config for the public demo.
//
// The demo is a pure static bundle — no Worker script, no `main` entry. Workers
// serves the files in `assets.directory` directly, so nothing here runs
// server-side. Deployment is Workers Builds' default `npx wrangler deploy`,
// which reads this file.
//
// Build settings that pair with it (Workers dashboard → Settings → Build):
//   Path            /frontend        ← this file and package.json live here
//   Build command   npm run build:demo
//   Deploy command  (empty → npx wrangler deploy)
//   NODE_VERSION    22               ← Vite 8 needs ^20.19 || >=22.12
//
// Self-hosting the same bundle instead? See docker-compose.demo.yml; the nginx
// image reproduces this routing with nginx.demo.conf.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finlytics-demo",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist-demo",
    // The app uses BrowserRouter, so /analytics and friends exist only
    // client-side. This serves index.html (HTTP 200) for navigation requests
    // that match no file — and, unlike a blanket `/* -> /index.html` rewrite,
    // still returns a real 404 for a missing asset instead of HTML.
    "not_found_handling": "single-page-application"
  }
}
