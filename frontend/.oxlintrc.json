{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": ["typescript", "react", "unicorn", "oxc", "promise", "jsx-a11y"],

  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },

  "ignorePatterns": ["dist/**", "node_modules/**", "public/**"],

  "rules": {
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/rules-of-hooks": "error",
    "react/jsx-no-constructed-context-values": "error",

    "typescript/no-explicit-any": "warn",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],

    "eqeqeq": ["error", "smart"],
    "no-console": ["warn", { "allow": ["warn", "error"] }],

    "react/react-in-jsx-scope": "off",

    "unicorn/no-null": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-add-event-listener": "off",

    "no-underscore-dangle": "off",
    "no-await-in-loop": "off",
    "promise/always-return": "off",
    // A spread inside .map() is how React state is updated immutably, on small arrays.
    "oxc/no-map-spread": "off",

    "react/no-array-index-key": "warn",
    "react/no-unstable-nested-components": "warn",
    // react-hooks/exhaustive-deps already fails on a missing dependency. This
    // compiler-derived rule reports those again, so a deliberate omission needs
    // two directives, and it flags extra ones, which in an effect is how "run
    // again when X changes" is written (the assistant autoscroll, the pickers
    // refocusing a cell after the grid moves).
    "react/exhaustive-effect-dependencies": "off",

    // Non-modal panels and pickers remain custom widgets, a live region is not
    // an <output> calculation, and the comboboxes render chips a <select> cannot.
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-redundant-roles": "warn",
    "jsx-a11y/control-has-associated-label": ["warn", { "depth": 3 }],
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    // oxlint ships no allowlist; this is eslint-plugin-jsx-a11y's recommended one,
    // so a <ul role="listbox"> with <li role="option"> children passes.
    "jsx-a11y/no-noninteractive-element-to-interactive-role": ["warn", {
      "ul": ["listbox", "menu", "menubar", "radiogroup", "tablist", "tree", "treegrid"],
      "ol": ["listbox", "menu", "menubar", "radiogroup", "tablist", "tree", "treegrid"],
      "li": ["menuitem", "menuitemradio", "menuitemcheckbox", "option", "row", "tab", "treeitem"],
      "table": ["grid"],
      "td": ["gridcell"],
      "fieldset": ["radiogroup", "presentation"]
    }],
    "jsx-a11y/no-noninteractive-tabindex": "warn",
    "jsx-a11y/no-autofocus": "warn",
    "jsx-a11y/label-has-associated-control": ["warn", { "depth": 3 }],
    "jsx-a11y/role-has-required-aria-props": "warn"
  }
}
